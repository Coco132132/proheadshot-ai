# Environment Variables
# Copy this file to .env.local and fill in your values

# -----------------------------------------------
# Astria.ai — AI Headshot Generation
# Get API key: https://www.astria.ai/users/edit#api
# -----------------------------------------------
ASTRIA_API_KEY=your_astria_api_key_here

# -----------------------------------------------
# PayPal — Payment Processing
# Create app: https://developer.paypal.com/dashboard/applications
# Use Sandbox keys for testing, Live keys for production
# -----------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox   # Change to "production" when going live

# -----------------------------------------------
# App
# -----------------------------------------------
# Your deployed domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://proheadshot.ai

# -----------------------------------------------
# Cloudflare R2 (optional in v1)
# For signed URL HD downloads
# -----------------------------------------------
# CF_ACCOUNT_ID=
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET_NAME=proheadshot-images
