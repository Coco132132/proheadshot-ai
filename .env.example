# Environment Variables
# Copy this file to .env.local and fill in your values

# Astria.ai API Key
# Get from: https://www.astria.ai/users/edit#api
ASTRIA_API_KEY=your_astria_api_key_here

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Your deployed domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://proheadshot.ai

# Cloudflare R2 (optional in v1, for signed URL downloads)
# CF_ACCOUNT_ID=
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET_NAME=proheadshot-images
